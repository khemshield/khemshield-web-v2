# Copy to `.env.local` and fill in real values. `.env*.local` is gitignored.

# Origin of the Khemshield backend API, without the /api/v1 suffix.
# Server actions append it themselves. Local backend runs on port 5000.
KHEMSHIELD_BASE_URL="http://localhost:5000"

# Server-side key for the "How AI Works" blog demo (/api/ai-demo proxy).
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Review / testimonial system.
#
# TEMPORARY: persistence for testimonials lives in this Next app while the
# Render backend is down. app/lib/reviews/ is written to be portable, when the
# backend is back the models + service move to backend/app/modules/testimonial/
# and app/(studio) + app/api/reviews are deleted. See web/CLAUDE.md.
# ---------------------------------------------------------------------------

# Same Atlas cluster the backend uses, same variable name so the lift is clean.
# Local dev points at khemshield_db_dev, production at khemshield_db.
MONGODB_URL=

# Passphrase for /studio/reviews. Any phrase of 12+ characters works, it does not
# have to be random. To change it, edit this value and restart: every open studio
# session is invalidated automatically because the session cookie is derived from
# this secret. Generate a random one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_REVIEW_SECRET=

# Salt for hashing submitter IPs. Changing it orphans existing hashes.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
REVIEW_IP_SALT=

# Cloudinary, for testimonial photos (Cloudinary console > Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend, for emailing review invite links from /studio/reviews. Same values as
# backend/.env. RESEND_FROM accepts either "addr@example.com" or
# "Name <addr@example.com>", and the domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM=

# Where client replies land. The Resend sending subdomain has no MX records, so
# this must be a real receiving inbox, not the RESEND_FROM address.
RESEND_REPLY_TO=
